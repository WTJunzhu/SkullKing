{
  "name": "skullking",
  "version": "1.0.0",
  "description": "Skull King multiplayer card game",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npx nodemon src/index.js",
    "dev:client": "cd client && npx vite",
    "build:client": "cd client && npx vite build",
    "start": "node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}